<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ===== ENCABEZADO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#C8EFB0"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_person"
            android:contentDescription="Icono usuario"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/atkinson_hyperlegible"
            android:text="Eres Monitor"
            android:textColor="#2E7D32"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== CONTENIDO CENTRAL ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- Círculo con visualizador de ondas -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="28dp">

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/circle_background"/>

            <com.example.babymonitor.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="24dp"/>

            <View
                android:id="@+id/recordingDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/dot_recording"
                android:layout_gravity="top|end"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Botones de control -->
        <TextView
            android:id="@+id/tvNivelSonido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/atkinson_hyperlegible"
            android:text="Nivel: 0"
            android:textColor="#444444"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <!-- Play -->
            <ImageButton
                android:id="@+id/btnIniciar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/btn_circle_outline"
                android:contentDescription="Reproducir"
                android:layout_marginEnd="12dp"/>

            <!-- Pausar -->
            <ImageButton
                android:id="@+id/btnPause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_pause"
                android:background="@drawable/btn_circle_outline"
                android:contentDescription="Pausar"
                android:layout_marginEnd="12dp"/>

            <!-- Detener -->
            <ImageButton
                android:id="@+id/btnDetener"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_stop"
                android:background="@drawable/btn_circle_filled"
                android:contentDescription="Detener"/>
        </LinearLayout>

        <!-- Estado del monitoreo -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/atkinson_hyperlegible"
            android:text="Estado: Detenido 🔴"
            android:textColor="#444444"
            android:textSize="15sp" />

        <!-- Nivel de sonido -->

        <!-- Código de sala -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/atkinson_hyperlegible"
            android:text="Código de sala:"
            android:textColor="#444444"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvCodigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/atkinson_hyperlegible"
            android:letterSpacing="0.15"
            android:textColor="#2C2C2C"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== FOOTER / MENÚ ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:background="@drawable/footer_background"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="63dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Inicio"
                android:src="@drawable/ic_home" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>