<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F8F9FA">

    <ImageButton
        android:id="@+id/btnRetroceder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_revert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_gravity="start"
        android:layout_alignParentStart="true"
        android:contentDescription="Volver"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📡 Modo Monitor"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvCodigo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Código de sala: ------"
        android:textSize="18sp"
        android:textColor="#3498DB"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado: Detenido 🔴"
        android:textSize="16sp"
        android:textColor="#7F8C8D"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nivel de sonido:"
        android:textSize="14sp"
        android:textColor="#7F8C8D"/>

    <ProgressBar
        android:id="@+id/progressSonido"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10000"
        android:progress="0"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvNivelSonido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nivel: 0"
        android:textSize="16sp"
        android:textColor="#3498DB"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnIniciar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="▶ Iniciar Monitoreo"
        android:textSize="18sp"
        android:backgroundTint="#2ECC71"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnDetener"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="⏹ Detener Monitoreo"
        android:textSize="18sp"
        android:backgroundTint="#E74C3C"/>

</LinearLayout>