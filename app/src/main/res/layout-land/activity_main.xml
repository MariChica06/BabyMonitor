<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- Columna izquierda: logo + título -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Logo bebé durmiendo"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_app_photoroom"
                tools:src="@drawable/logo_app_photoroom" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/atkinson_hyperlegible"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Monitorea el descanso\nde tu bebé"
                android:textAlignment="center"
                android:textColor="#2C2C2C"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Divisor vertical -->
        <View
            android:layout_width="1dp"
            android:layout_height="180dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="#E0E0E0" />

        <!-- Columna derecha: pregunta + botones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvPregunta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/atkinson_hyperlegible"
                android:text="¿Eres ...?"
                android:textAlignment="center"
                android:textColor="#2C2C2C"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnModoMonitor"
                android:layout_width="200dp"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#8FE07A"
                android:elevation="0dp"
                android:fontFamily="@font/atkinson_hyperlegible"
                android:stateListAnimator="@null"
                android:text="Monitor"
                android:textColor="#2C2C2C"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="30dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/atkinson_hyperlegible"
                android:text="o"
                android:textColor="#888888"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnModoPadre"
                android:layout_width="200dp"
                android:layout_height="52dp"
                android:backgroundTint="#7DD4C8"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Receptor"
                android:textColor="#2C2C2C"
                android:textSize="18sp"
                app:cornerRadius="50dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>